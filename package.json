{
  "name": "opentalk-lostark-bot",
  "version": "1.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "로스트아크 정보 조회 디스코드 봇",
  "main": "src/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "register": "node --env-file=.env src/register-commands.js",
    "dev": "node --env-file=.env.dev src/index.js",
    "dev:register": "node --env-file=.env.dev src/register-commands.js",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs tests/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "discord.js": "^14.27.0"
  }
}
